! как openapi
! типизация-сахара(api) заголовок / версия
! типизация-сахара(сервер) адрес
! типизация-сахара(путь) адрес / описание
! типизация-сахара(метод) глагол / операция
! типизация-сахара(схема) имя / описание
! типизация-сахара(поле) имя / тип

api = Заказы / 1.0.0 .описание "API заказов"
  сервер = https://api.example.com/v1

  ..пути
    путь = /orders / "Заказы"
      метод = get / "Список заказов" .ответ 200 .ответ 500
      метод = post / "Создать заказ" .ответ 201 .запрос Заказ .обязательное да

    путь = /orders/{id} / "Один заказ"
      метод = get / "Карточка заказа" .ответ 200 .ответ 404
      метод = delete / "Удалить заказ" .ответ 204

  ..схемы
    схема = Заказ / "Заказ покупателя"
      поле = id / целое .формат int64 .обязательное да .описание "Номер заказа"
      поле = status / строка .значение new .значение paid .значение shipped
      поле = items / массив .элемент строка .описание "Состав заказа"
      поле = client / ссылка:Клиент

    схема = Клиент
      поле = name / строка .обязательное да
      поле = email / строка .формат email

