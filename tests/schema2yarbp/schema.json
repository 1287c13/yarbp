{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Заказ",
  "$id": "https://example.com/order.schema.json",
  "description": "Заказ покупателя",
  "$ref": "#/$defs/Заказ",
  "$defs": {
    "Заказ": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "int64",
          "description": "Номер заказа"
        },
        "status": {
          "type": "string",
          "enum": ["new", "paid"]
        },
        "items": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Состав заказа"
        },
        "client": {
          "$ref": "#/$defs/Клиент"
        }
      },
      "required": ["id", "client"],
      "description": "Заказ покупателя"
    },
    "Клиент": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" }
      },
      "required": ["name"],
      "description": "Покупатель"
    }
  }
}
