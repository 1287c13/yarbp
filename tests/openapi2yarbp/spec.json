{
  "openapi": "3.0.3",
  "info": {
    "title": "Заказы",
    "version": "1.0.0",
    "description": "API заказов"
  },
  "servers": [
    { "url": "https://api.example.com/v1" }
  ],
  "paths": {
    "/orders": {
      "description": "Заказы",
      "get": {
        "summary": "Список заказов",
        "responses": {
          "200": { "description": "OK" },
          "500": { "description": "Internal Server Error" }
        }
      },
      "post": {
        "summary": "Создать заказ",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Заказ" }
            }
          }
        },
        "responses": {
          "201": { "description": "Created" }
        }
      }
    },
    "/orders/{id}": {
      "description": "Один заказ",
      "get": {
        "summary": "Карточка заказа",
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not Found" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Заказ": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "Номер заказа"
          },
          "status": {
            "type": "string",
            "enum": ["new", "paid"]
          },
          "items": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Состав заказа"
          },
          "client": {
            "$ref": "#/components/schemas/Клиент"
          }
        },
        "required": ["id", "client"],
        "description": "Заказ покупателя"
      },
      "Клиент": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" }
        },
        "required": ["name"],
        "description": "Покупатель"
      }
    }
  }
}
