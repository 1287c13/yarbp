! как схема
api = Заказ .версия 1.0.0 .ид "https://example.com/order.schema.json" .описание "Заказ покупателя" .корень Заказ
  ..схемы
    схема = Заказ
      поле = id .тип целое .формат int64 .обязательное да .описание "Номер заказа"
      поле = status .тип строка .значение new .значение paid
      поле = items .тип массив .элемент строка
      поле = client .тип ссылка:Клиент .обязательное да
    схема = Клиент
      поле = name .тип строка .обязательное да
      поле = email .тип строка .формат email
