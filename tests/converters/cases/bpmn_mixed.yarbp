! как БПМН
процесс = Смешанный
  ..роли
    роль .имя Менеджер
    роль .имя Кладовщик
  событие = Начало
    шлюз = Есть заказ?
      ветка = да
        задача = Собрать заказ .роль Кладовщик
          событие = Таймаут .тип таймер
        задача = Упаковать .роль Кладовщик
      ветка = нет
        событие = Отказ .расположение конец
    событие .расположение конец
