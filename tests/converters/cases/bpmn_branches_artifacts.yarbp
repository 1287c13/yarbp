! как БПМН
процесс = Отгрузка
  ..роли
    роль .имя Кладовщик
    роль .имя Водитель
  событие = Начало
    задача = Собрать заказ .роль Кладовщик
      комментарий = Заказ собран по накладной
      данные = Накладная
      база-данных = Склад
    шлюз = Готово?
      ветка = да
        задача = Передать в доставку .роль Водитель .тип сервис
      ветка = нет
        задача = Дособрать .повторение цикл
    событие .расположение конец
