! как БПМН
процесс = Заказчик
  событие = Начало
    задача = Оформить заказ .ид Task_Order
    задача = Отправить заявку .ид Task_Send .тип отправка-сообщения
      связь = --> Task_Accept
    событие .расположение конец
процесс = Исполнитель
  событие = Начало
    задача = Принять заявку .ид Task_Accept .тип получение-сообщения
    событие .расположение конец
