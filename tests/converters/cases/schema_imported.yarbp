! как схема

api = Заказ .ид https://example.com/order.schema.json .описание "Заказ покупателя" .корень Заказ
  ..схемы
    схема = Заказ .описание "Заказ покупателя"
      поле = id .тип целое .формат int64 .описание "Номер заказа" .обязательное да
      поле = status .тип строка .значение new .значение paid
      поле = items .тип массив .элемент строка .описание "Состав заказа"
      поле = client .тип ссылка:Клиент .обязательное да
    схема = Клиент .описание Покупатель
      поле = name .тип строка .обязательное да
      поле = email .тип строка .формат email
